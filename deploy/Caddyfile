# HTTPS per Let's Encrypt vor der App. Caddy holt und erneuert das Zertifikat automatisch.
#
# PUBLIC_HOST (Server-IP oder Domain) und HTTPS_PORT kommen aus der .env.
#
# IP-Zertifikate gibt es bei Let's Encrypt nur mit dem Profil "shortlived" (ca. 6 Tage gültig).
# Die Prüfung läuft über HTTP-01 auf Port 80, der deshalb erreichbar sein muss.

{
	# Browser schicken bei IP-Adressen kein SNI im TLS-Handshake. Ohne default_sni wüsste
	# Caddy nicht, welches Zertifikat gemeint ist, und bricht mit "internal error" ab.
	default_sni {$PUBLIC_HOST}
}

https://{$PUBLIC_HOST}:{$HTTPS_PORT} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip
	reverse_proxy chronik:3000

	log {
		output stdout
		format console
	}
}
