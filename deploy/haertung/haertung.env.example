# Kopieren nach haertung.env (nicht versioniert, liegt neben den Skripten im Ordner ~/haertung auf dem Server).
# lib.sh lädt die Datei; Werte gelten nur, wenn die Variable nicht schon in der Umgebung gesetzt ist. Alles optional.

# Block 2: Name des Deploy-Nutzers (UID 1000 = Nutzer „node“ im Container, dem data/ gehört)
DEPLOY_USER_NAME=deploy

# Block 4: eigene feste IP (oder Netz) des Betreibers - wird von CrowdSec nie gesperrt
#OPERATOR_IP=

# Block 6: Sub-Account der Storage Box (Hetzner Console → Storage Box → Sub-Accounts; SFTP-Port 23)
#STORAGEBOX_USER=uXXXXXX-sub1
#STORAGEBOX_HOST=uXXXXXX.your-storagebox.de
#STORAGEBOX_PORT=23

# App-Instanzen als „name|ordner“, Leerzeichen-getrennt (Standard: prod und vorschau)
#FAP_INSTANCES=prod|/opt/bernersennen-stammbaum vorschau|/opt/bernersennen-stammbaum-staging

# Gemeinsamer Caddy-Proxy (Block 1 und 4 lesen ihn nur)
#CADDYFILE=/opt/proxy/Caddyfile
#PROXY_CONTAINER=server-proxy
