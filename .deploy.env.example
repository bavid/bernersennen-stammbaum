# Kopieren nach .deploy.env (gitignored) – wird von manage.ps1 gelesen. Enthält KEINE Secrets.
DEPLOY_HOST=203.0.113.10
# root nur bis zur SSH-Härtung (deploy/haertung/02-ssh.sh) - danach der Deploy-Nutzer (Standard: deploy)
DEPLOY_USER=root
APP_DIR=/opt/bernersennen-stammbaum
REPO_URL=https://github.com/bavid/bernersennen-stammbaum.git
BRANCH=main
HTTPS_PORT=3010
# Optional, sobald es eine Domain gibt (sonst bekommt die IP ein Let's-Encrypt-Zertifikat). Mit Domain gibt
# das Deploy am Ende den Caddy-Block für den gemeinsamen Proxy aus (nur ein Vorschlag, der Proxy wird nie geändert):
DEPLOY_DOMAIN=
# Optional: öffentliche Adresse der App (https://…, ohne Schrägstrich am Ende). Wird beim nächsten Deploy in die
# .env der Instanz übernommen (nur einmal, später dort von Hand ändern) und schaltet HSTS und Secure-Cookies ein;
# außerdem Ziel der QR-Codes auf den Druckbögen und Basis von robots.txt/sitemap.xml. Beispiel:
# PUBLIC_URL=https://familieaufpfoten.de
PUBLIC_URL=
