# Kopieren nach .env (liegt nur auf dem Server, nie ins Git!)
# deploy/remote.sh setup erzeugt die Datei automatisch mit zufälligen Werten.

# Pflicht: langes Zufalls-Secret für die Session-Cookies, z. B. `openssl rand -hex 32`
JWT_SECRET=

# Optional: Code, den man zum Anlegen eines neuen Rudels braucht.
# Leer lassen = jeder, der die Seite erreicht, darf ein Rudel anlegen.
FAMILY_INVITE_CODE=

# Adresse der Seite: https://PUBLIC_HOST:HTTPS_PORT (Server-IP oder Domain).
# Die App lauscht auf 127.0.0.1:HTTPS_PORT; HTTPS davor macht der gemeinsame Server-Proxy.
PUBLIC_HOST=203.0.113.10
HTTPS_PORT=3010

# Cookies nur über HTTPS senden (hinter dem Proxy immer true)
COOKIE_SECURE=true

# Die App steht hinter Caddy: 1 Proxy-Hop, damit das Login-Rate-Limit echte IPs sieht.
TRUST_PROXY=1
