# Kopieren nach .env (liegt nur auf dem Server, nie ins Git!)
# deploy/remote.sh setup erzeugt die Datei automatisch mit zufälligen Werten.

# Pflicht: langes Zufalls-Secret für die Session-Cookies, z. B. `openssl rand -hex 32`
JWT_SECRET=

# Pflicht: Zufalls-Secret für Gutschein-Codes (Nachschlage-Hash und Verschlüsselung), mindestens
# 32 Zeichen, z. B. `openssl rand -hex 32`. Darf sich nach dem ersten Setzen NIE mehr ändern -
# sonst sind alle bestehenden Codes (Schlüssel/Login der Familien) wertlos. Gehört wie JWT_SECRET
# zur .env-Datensicherung.
CODE_PEPPER=

# Optional: Anzahl Gutscheine, die jeder Bereich (Rudel oder Zuhause) zum Weitergeben vorrätig hat.
# Standard: 3
RUDEL_VOUCHER_QUOTA=

# Adresse der Seite: https://PUBLIC_HOST:HTTPS_PORT (Server-IP oder Domain).
# Die App lauscht auf 127.0.0.1:HTTPS_PORT; HTTPS davor macht der gemeinsame Server-Proxy.
PUBLIC_HOST=203.0.113.10
HTTPS_PORT=3010

# Cookies nur über HTTPS senden (hinter dem Proxy immer true)
COOKIE_SECURE=true

# Die App steht hinter Caddy: 1 Proxy-Hop, damit das Login-Rate-Limit echte IPs sieht.
TRUST_PROXY=1

# Impressum/Datenschutz (siehe /impressum, /datenschutz): ohne diese vier bleibt das Impressum beim
# ehrlichen Hinweis "Die Betreiberangaben werden vor dem Start ergänzt." - NIE erfundene Angaben
# eintragen. IMPRESSUM_ADRESSE ist mehrzeilig: mehrere Zeilen mit dem literalen \n trennen (ein echter
# Zeilenumbruch geht in einer .env-Datei nicht), z. B. "Musterstraße 1\n12345 Musterstadt".
IMPRESSUM_NAME=
IMPRESSUM_ADRESSE=
IMPRESSUM_EMAIL=
IMPRESSUM_TELEFON=

# Umkreissuche ("In der Nähe", Partnerliste): Anbieter neben den Partnern - 'overpass' fragt echt bei
# OpenStreetMap an (Standard in Produktion), 'fixture' liefert feste, fiktive Testdaten ohne
# Internetzugriff (Standard sonst, auch auf der Vorschau, bis echte Anfragen gewünscht sind).
PLACES_PROVIDERS=

# Höchstens so viele echte Overpass-Anfragen pro Tag (Standard 500) - danach nur noch Cache und Partner.
PLACES_DAILY_LIMIT=

# Öffentliche Adresse der Seite (https://…), steht im User-Agent der Umkreissuche gegenüber Overpass/OSM
# ("+https://…/bot"), damit dort nachvollziehbar bleibt, wer anfragt. Ohne Angabe wird der angefragte
# Hostname verwendet.
PUBLIC_URL=
